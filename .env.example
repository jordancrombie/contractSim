# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contractsim?schema=public"

# Server
PORT=3003
NODE_ENV=development

# Service Authentication (S2S API Keys)
WSIM_API_KEY=wsim_dev_key_change_in_production
BSIM_API_KEY=bsim_dev_key_change_in_production
TRANSFERSIM_API_KEY=transfersim_dev_key_change_in_production

# External Service URLs
WSIM_URL=http://localhost:3002
BSIM_URL=http://localhost:3001
TRANSFERSIM_URL=http://localhost:3004

# Contract Defaults
DEFAULT_FUNDING_TIMEOUT_HOURS=48
MAX_CONTRACT_VALUE=100.00
DEFAULT_CURRENCY=CAD
