generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CONTRACT MODELS
// ============================================

model Contract {
  id     String         @id @default(uuid())
  type   ContractType
  status ContractStatus @default(DRAFT)

  title       String
  description String?

  // Stakes
  totalPot Decimal @db.Decimal(12, 2)
  currency String  @default("CAD")

  // Escrow settings
  escrowType     EscrowType     @default(FULL)
  settlementType SettlementType @default(WINNER_TAKES_ALL)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  acceptedAt      DateTime?
  fundedAt        DateTime?
  resolvedAt      DateTime?
  settledAt       DateTime?
  expiresAt       DateTime
  fundingDeadline DateTime

  // Relations
  parties    ContractParty[]
  conditions Condition[]
  outcome    ContractOutcome?
  dispute    Dispute?
  auditLogs  AuditLog[]

  // Idempotency
  idempotencyKey String? @unique

  @@index([status])
  @@index([createdAt])
}

model ContractParty {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Identity (from WSIM)
  walletId    String // e.g., "WLLT-ABC123"
  bankId      String // e.g., "bsim"
  displayName String

  // Role
  role PartyRole

  // Stake
  stakeAmount   Decimal @db.Decimal(12, 2)
  stakeCurrency String  @default("CAD")

  // Outcomes
  outcomeIfTrue  OutcomeType @default(WINNER)
  outcomeIfFalse OutcomeType @default(LOSER)

  // Status
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  funded     Boolean   @default(false)
  fundedAt   DateTime?

  // BSIM references
  escrowId   String? // Escrow hold ID (from BSIM)
  bsimUserId String? // BSIM user ID (from WSIM funding request)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, walletId])
  @@index([walletId])
}

model Condition {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  index Int @default(0)

  // Oracle reference
  oracleId  String
  eventType String
  eventId   String

  // Predicate
  predicateField    String
  predicateOperator PredicateOperator
  predicateValue    String

  // Resolution
  status     ConditionStatus @default(PENDING)
  result     Boolean?
  evidence   Json?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, index])
}

model ContractOutcome {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  winnerId String? // walletId of winner (if applicable)
  loserId  String? // walletId of loser (if applicable)

  settlementType String // "winner_payout", "refund", "partial"

  // Transfer reference (from TransferSim)
  transferId   String?
  settlementId String?

  createdAt DateTime @default(now())
}

model Dispute {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  filedBy  String // walletId
  reason   String
  evidence Json?

  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedBy String? // admin userId
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// ORACLE MODELS
// ============================================

model Oracle {
  id          String  @id @default(uuid())
  oracleId    String  @unique // e.g., "test_oracle", "sports_api"
  name        String
  description String?

  eventTypes String[] // ["game_outcome", "game_score"]
  webhookUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OracleEvent[]
}

model OracleEvent {
  id       String @id @default(uuid())
  oracleId String
  oracle   Oracle @relation(fields: [oracleId], references: [oracleId])

  eventId     String // External event ID
  eventType   String
  title       String
  description String?

  status EventStatus @default(UPCOMING)

  startsAt DateTime
  endsAt   DateTime?

  // Result (when resolved)
  result     Json?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oracleId, eventId])
  @@index([status, startsAt])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String    @id @default(uuid())
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  action String // e.g., "CONTRACT_CREATED", "STATUS_CHANGED"
  actor  String // walletId or "system" or "oracle:{id}"

  previousState Json?
  newState      Json?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([contractId])
  @@index([createdAt])
}

// ============================================
// WEBHOOK TRACKING
// ============================================

model WebhookDelivery {
  id String @id @default(uuid())

  destination String // "wsim", "bsim", "transfersim"
  url         String
  eventType   String
  payload     Json

  status        WebhookStatus @default(PENDING)
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?

  responseStatus Int?
  responseBody   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

// ============================================
// IDEMPOTENCY
// ============================================

model IdempotencyKey {
  id  String @id @default(uuid())
  key String @unique

  requestHash    String
  responseStatus Int
  responseBody   Json

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ============================================
// ENUMS
// ============================================

enum ContractType {
  WAGER
  ESCROW
  MILESTONE
  CUSTOM
}

enum ContractStatus {
  DRAFT
  PROPOSED
  FUNDING
  ACTIVE
  SETTLING
  SETTLED
  EXPIRED
  CANCELLED
  DISPUTED
}

enum EscrowType {
  FULL
  PARTIAL
  NONE
}

enum SettlementType {
  WINNER_TAKES_ALL
  PROPORTIONAL
  CUSTOM
}

enum PartyRole {
  CREATOR
  COUNTERPARTY
}

enum OutcomeType {
  WINNER
  LOSER
  REFUND
  CUSTOM
}

enum ConditionStatus {
  PENDING
  RESOLVED
  DISPUTED
}

enum PredicateOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  LESS_THAN
  CONTAINS
  IN
}

enum EventStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  EXPIRED
}
